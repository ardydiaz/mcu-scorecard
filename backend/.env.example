# Server
NODE_ENV=development
PORT=5005
# 127.0.0.1 = reachable only from this server (nginx forwards to it). Use 0.0.0.0 only without a reverse proxy.
HOST=127.0.0.1
# Proxies allowed to report the visitor's IP: loopback (nginx on this server), an IP/subnet, a hop count, or false
TRUST_PROXY=loopback
CLIENT_URL=http://localhost:6001

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mcu_scorecard
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Microsoft Entra ID (Azure AD) app registration
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Excel workbook on SharePoint/OneDrive used for strategy data
EXCEL_DRIVE_ID=
EXCEL_ITEM_ID=
